<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Account__c</field>
        <field>Begin_Date__c</field>
        <field>End_Date__c</field>
        <field>Discount_Category__c</field>
        <field>Contract_Type__c</field>
        <field>Promo_Code__c</field>
        <field>Planned_Fee__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Korea_Finance_Director</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Promotion_Activity__c.Is_Under_Promotional_Target_ROI__c</field>
                <operation>equals</operation>
                <value>True</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Less than Target ROI</label>
        <name>Less_than_Target_ROI</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Korea_Sales_Manager</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Sales Manager</label>
        <name>Sales_Manager</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Korea_Sales_Director</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>Unanimous</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Promotion_Activity__c.Activity_Budget__c</field>
                <operation>greaterOrEqual</operation>
                <value>&quot;KRW 5,000,000&quot;</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>ApproveRecord</ifCriteriaNotMet>
        <label>Sales Director</label>
        <name>Sales_Director</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Korea_Finance_Director</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Promotion_Activity__c.Activity_Budget__c</field>
                <operation>greaterOrEqual</operation>
                <value>&quot;KRW 50,000,000&quot;</value>
            </criteriaItems>
            <criteriaItems>
                <field>Promotion_Activity__c.Is_Under_Promotional_Target_ROI__c</field>
                <operation>equals</operation>
                <value>False</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Finance Director</label>
        <name>Finance_Director</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Korea_General_Manager</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Promotion_Activity__c.Activity_Budget__c</field>
                <operation>greaterOrEqual</operation>
                <value>&quot;KRW 250,000,000&quot;</value>
            </criteriaItems>
        </entryCriteria>
        <label>General Manager</label>
        <name>General_Manager</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <emailTemplate>Workflow_Email_Templates/KR_PSA_Manager_Review</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Promotion_Activity__c.RecordType</field>
            <operation>equals</operation>
            <value>KR - PSA</value>
        </criteriaItems>
        <criteriaItems>
            <field>Promotion_Activity__c.Status__c</field>
            <operation>equals</operation>
            <value>Submitted</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Activity_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Activity_Approved_Date</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Activity_Final_Approver</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Activity_Has_Been_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>KR_PSA_Status_Changed</name>
            <type>Alert</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Activity_Rejected</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>KR_PSA_Status_Changed</name>
            <type>Alert</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Activity_Pending_Approval</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>KR_PSA_Submitted</name>
            <type>Alert</type>
        </action>
    </initialSubmissionActions>
    <label>Korea PSA v4</label>
    <recallActions>
        <action>
            <name>Activity_Recalled</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
